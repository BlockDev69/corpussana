# Copiez ce fichier en .env et remplissez les valeurs (ne jamais committer .env)

# Base de données Turso
TURSO_DATABASE_URL=libsql://<votre-base>.turso.io
TURSO_AUTH_TOKEN=

# Clé longue et aléatoire : signe les sessions admin et protège l'API POST /api/articles
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Mot de passe de connexion à /admin (16 caractères ou plus)
ADMIN_PASSWORD=
