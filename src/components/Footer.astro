---
// Footer.astro — Pied de page moderne inspiré de Corus International
// Cohérent avec Header.astro (palette, logo, navigation)

const year = new Date().getFullYear();

const navColumns = [
  {
    title: "Qui sommes-nous",
    links: [
      { label: "Notre mission", href: "/notre-mission" },
      { label: "Notre équipe", href: "/notre-equipe" },
      { label: "Nos partenaires", href: "/nos-partenaires" },
      { label: "Rapports annuels", href: "/rapports-annuels" },
    ],
  },
  {
    title: "Nos domaines",
    links: [
      { label: "Santé", href: "/sante" },
      { label: "Nutrition", href: "/nutrition" },
      { label: "Éducation", href: "/education" },
      { label: "Environnement", href: "/environnement" },
    ],
  },
  {
    title: "Impact",
    links: [
      { label: "Actualités", href: "/actualites" },
      { label: "Ressources", href: "/ressources" },
      { label: "Témoignages", href: "/temoignages" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="container footer-grid">
      <!-- Colonne marque -->
      <div class="footer-brand">
        <a href="/" class="logo">
          <span class="logo-text">Corpus <strong>Sana</strong></span>
        </a>
        <p class="brand-desc">
          Organisation Non Gouvernementale de Développement basée en RD Congo,
          engagée pour le bien-être universel et intégral de l'Homme, en
          particulier la santé.
        </p>

        <div class="social-links">
          <a href="#" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Colonnes de navigation -->
      {
        navColumns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <h3 class="footer-col-title">{col.title}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <!-- Colonne contact / newsletter -->
      <div class="footer-contact">
        <h3 class="footer-col-title">Restons en contact</h3>
        <ul class="contact-list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Kinshasa, RD Congo</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:contact@corpussana.org">contact@corpussana.org</a>
          </li>
        </ul>

        <form class="newsletter" onsubmit="return false;">
          <label for="footer-email" class="newsletter-label">Newsletter</label>
          <div class="newsletter-field">
            <input id="footer-email" type="email" placeholder="Votre adresse e-mail" required />
            <button type="submit" aria-label="S'abonner">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">© {year} Corpus Sana ONGD. Tous droits réservés.</p>
      <ul class="legal-links">
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/politique-confidentialite">Confidentialité</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --color-primary: #022c43;
    --color-accent: #ff5a1f;
    --color-accent-hover: #e0440b;
    --color-border: rgba(255, 255, 255, 0.1);
    --radius-sm: 6px;
    --radius-full: 9999px;
    --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: var(--color-primary);
    color: rgba(255, 255, 255, 0.7);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer a { text-decoration: none; color: inherit; }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    box-sizing: border-box;
  }

  /* --- Bloc principal --- */
  .footer-main {
    padding: clamp(3rem, 6vw, 5rem) 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
  }

  /* --- Marque --- */
  .logo-text {
    font-size: 1.6rem;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.03em;
  }
  .logo-text strong { font-weight: 800; color: var(--color-accent); }

  .brand-desc {
    margin: 1.25rem 0 1.75rem;
    max-width: 340px;
    font-size: 0.9rem;
  }

  .social-links { display: flex; gap: 0.75rem; }
  .social-links a {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.8);
    transition: var(--transition-smooth);
  }
  .social-links a:hover {
    background: var(--color-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* --- Colonnes de liens --- */
  .footer-col-title {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .footer-col li { margin-bottom: 0.7rem; }
  .footer-col a {
    position: relative;
    transition: var(--transition-smooth);
  }
  .footer-col a:hover {
    color: #ffffff;
    padding-left: 0.4rem;
  }

  /* --- Contact / newsletter --- */
  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }
  .contact-list svg { color: var(--color-accent); flex-shrink: 0; }
  .contact-list a:hover { color: #ffffff; }

  .newsletter { margin-top: 1.5rem; }
  .newsletter-label {
    display: block;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .newsletter-field {
    display: flex;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: var(--transition-smooth);
  }
  .newsletter-field:focus-within { border-color: var(--color-accent); }
  .newsletter-field input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    padding: 0.7rem 0.9rem;
    color: #ffffff;
    font-size: 0.875rem;
  }
  .newsletter-field input::placeholder { color: rgba(255, 255, 255, 0.5); }
  .newsletter-field button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    background: var(--color-accent);
    color: #ffffff;
    border: none;
    cursor: pointer;
    transition: var(--transition-smooth);
  }
  .newsletter-field button:hover { background: var(--color-accent-hover); }

  /* --- Bas de page --- */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
    background-color: rgba(0, 0, 0, 0.15);
  }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .copyright { margin: 0; font-size: 0.85rem; }
  .legal-links { display: flex; gap: 1.5rem; }
  .legal-links a {
    font-size: 0.85rem;
    transition: var(--transition-smooth);
  }
  .legal-links a:hover { color: #ffffff; }

  /* --- Responsive --- */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .legal-links { gap: 1.25rem; flex-wrap: wrap; }
  }
</style>