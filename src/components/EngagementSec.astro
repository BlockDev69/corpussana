---
// EngagementSec.astro
// Section "Notre mission" — Style Square UI / Neo-Brutalist
// Sans JavaScript, CSS encapsulé.

const tempImageUrl =
  "https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&w=1000&q=80";

const engagements = [
  {
    color: "blue",
    title: "Propulsé par la technologie",
    text: "En plaçant les outils numériques et l'analyse de données au cœur de notre action, nous générons un impact mesurable et à grande échelle.",
  },
  {
    color: "orange",
    title: "Penser et agir autrement",
    text: "Nous allions expertise pointue et innovation pour surmonter les défis les plus complexes sur le terrain.",
  },
  {
    color: "green",
    title: "Guidés par la foi, portés par l'action",
    text: "Guidés par notre foi, nous donnons un sens profond à nos actions et assumons pleinement notre responsabilité envers les autres.",
  },
];
---

<section class="engagements">
  <div class="container">
    <!-- En-tête -->
    <header class="section-header">
      <h2 class="section-title">Agir autrement pour des résultats durables</h2>
    </header>

    <div class="layout">
      <!-- Colonne image -->
      <div class="image-column">
        <div class="image-wrapper">
          <img
            src={tempImageUrl}
            alt="Communauté bénéficiaire de nos programmes"
            class="feature-image"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Colonne engagements -->
      <div class="text-column">
        <ul class="engagements-list">
          {
            engagements.map((item) => (
              <li class={`engagement-card accent-${item.color}`}>
                <div class="card-body">
                  <h3 class="card-title">{item.title}</h3>
                  <p class="card-text">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <a class="btn btn-primary" href="/about/about-us">
          En savoir plus sur nous
          <svg
            class="arrow-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"
            stroke-linejoin="miter"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- DESIGN TOKENS (Square UI) --- */
  .engagements {
    --color-primary: #022c43;
    --color-text: #0f172a;
    --color-text-muted: #475569;
    --color-bg: #f1f5f9;
    --color-white: #ffffff;
    
    --blue: #009cb4;
    --orange: #eb690b;
    --green: #48a23f;

    /* Strict zero radius */
    --radius: 0px;

    /* Hard, offset shadows for strict Square UI */
    --shadow-hard: 4px 4px 0px var(--color-primary);
    --shadow-hard-lg: 7px 7px 0px var(--color-primary);
    
    --ease: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: var(--color-bg);
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--color-text);
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- EN-TÊTE --- */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* --- LAYOUT --- */
  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .layout {
      grid-template-columns: 1.05fr 1fr;
      gap: 5rem;
    }
  }

  /* --- COLONNE IMAGE --- */
  .image-column {
    position: relative;
  }

  .image-wrapper {
    border: 3px solid var(--color-primary);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: #cbd5e1;
    transition: var(--ease);
  }

  .image-wrapper:hover {
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0px var(--color-primary);
  }

  .feature-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .image-wrapper:hover .feature-image {
    transform: scale(1.03);
  }

  /* --- COLONNE TEXTE --- */
  .text-column {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .engagements-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .engagement-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: var(--color-white);
    border: 2px solid var(--color-primary);
    border-left-width: 6px; /* Accent color will override this */
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard);
    padding: 1.5rem;
    transition: var(--ease);
    position: relative;
  }

  .engagement-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hard-lg);
  }

  .accent-blue { border-left-color: var(--blue); }
  .accent-orange { border-left-color: var(--orange); }
  .accent-green { border-left-color: var(--green); }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-primary);
  }

  .accent-blue .card-title { color: var(--blue); }
  .accent-orange .card-title { color: var(--orange); }
  .accent-green .card-title { color: var(--green); }

  .card-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 500;
  }

  /* --- BOUTON --- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard);
    transition: var(--ease);
    align-self: flex-start;
    letter-spacing: 0.02em;
  }

  /* Tactile press effect */
  .btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--color-primary);
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .btn-primary:hover {
    background-color: var(--color-white);
    color: var(--color-primary);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-lg);
  }

  .arrow-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 768px) {
    .engagements {
      padding: 3rem 1.25rem;
    }

    .layout {
      gap: 2.5rem;
    }

    .btn {
      width: 100%;
      align-self: stretch;
    }
    
    .btn:active {
      transform: translate(1px, 1px);
      box-shadow: 1px 1px 0px var(--color-primary);
    }

    .card-title {
      font-size: 1.15rem;
    }
    
    .card-text {
      font-size: 0.95rem;
    }
  }
</style>