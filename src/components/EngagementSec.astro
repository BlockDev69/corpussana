---
// EngagementSec.astro
// Section "Notre mission" — style moderne inspiré de Corus International
// Sans JavaScript, CSS encapsulé.

const tempImageUrl =
  "https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&w=1000&q=80";

const engagements = [
  {
    color: "blue",
    title: "Propulsé par la technologie",
    text: "En plaçant les outils numériques et l'analyse de données au cœur de notre action, nous générons un impact mesurable et à grande échelle.",
  },
  {
    color: "orange",
    title: "Penser et agir autrement",
    text: "Nous allions expertise pointue et innovation pour surmonter les défis les plus complexes sur le terrain.",
  },
  {
    color: "green",
    title: "Guidés par la foi, portés par l'action",
    text: "Guidés par notre foi, nous donnons un sens profond à nos actions et assumons pleinement notre responsabilité envers les autres.",
  },
];
---

<section class="engagements">
  <div class="container">
    <!-- En-tête -->
    <header class="section-header">
      <h2 class="section-title">Agir autrement pour des résultats durables</h2>
      <!-- <p class="section-subtitle">
        Nous luttons pour l'amélioration de l'état de Santé des populations, 
        dans toutes ses formes possibles. Nous croyons que chaque humain est doté d'un potentiel qui puisse lui permettre de donner sa singularité comme un atout au développement physique,
        psychique et social de la communauté.
      </p> -->
    </header>

    <div class="layout">
      <!-- Colonne image -->
      <div class="image-column">
        <div class="image-wrapper">
          <img
            src={tempImageUrl}
            alt="Communauté bénéficiaire de nos programmes"
            class="feature-image"
            loading="lazy"
          />
        </div>

        <!-- <div class="stat-card stat-primary">
          <span class="stat-value">100M+</span>
          <span class="stat-label">Vies impactées</span>
        </div>

        <div class="stat-card stat-secondary">
          <span class="stat-value">25+</span>
          <span class="stat-label">Pays</span>
        </div> -->
      </div>

      <!-- Colonne engagements -->
      <div class="text-column">
        <ul class="engagements-list">
          {
            engagements.map((item) => (
              <li class={`engagement-card accent-${item.color}`}>
                <div class="card-body">
                  <h3 class="card-title">{item.title}</h3>
                  <p class="card-text">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <a class="btn btn-primary" href="/fr/who-we-are">
          En savoir plus sur nous
          <svg
            class="arrow-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- DESIGN TOKENS --- */
  .engagements {
    --text-main: #1e293b;
    --text-muted: #64748b;
    --blue: #009cb4;
    --orange: #eb690b;
    --green: #48a23f;
    --bg-section: #f8fafc;
    --white: #ffffff;
    --shadow-sm: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.08);
    --shadow-lg: 0 24px 40px -12px rgb(0 0 0 / 0.18);
    --radius-lg: 20px;
    --radius-md: 12px;
    --ease: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: var(--bg-section);
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--text-main);
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- EN-TÊTE --- */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: #64748b;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
  }

  .section-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    line-height: 1.65;
    color: #64748b;
    margin: 0;
  }

  /* --- LAYOUT --- */
  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .layout {
      grid-template-columns: 1.05fr 1fr;
      gap: 5rem;
    }
  }

  /* --- COLONNE IMAGE --- */
  .image-column {
    position: relative;
  }

  .image-wrapper {
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: #cbd5e1;
  }

  .feature-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: var(--ease);
  }

  .image-wrapper:hover .feature-image {
    transform: scale(1.05);
  }

  /* Cartes de statistiques flottantes */
  /* .stat-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    background: var(--white);
  }

  .stat-primary {
    bottom: 1.5rem;
    left: -1rem;
  }

  .stat-secondary {
    top: 1.5rem;
    right: -1rem;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--orange);
  }

  .stat-secondary .stat-value {
    color: var(--blue);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.35rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .stat-primary { left: 0.75rem; }
    .stat-secondary { right: 0.75rem; }
  } */

  /* --- COLONNE TEXTE --- */
  .text-column {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .engagements-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .engagement-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background-color: transparent;
    box-shadow: none;
    padding: 0.75rem 0 0.75rem 1.5rem;
    border-left: 4px solid transparent;
    transition: var(--ease);
  }

  .engagement-card:hover {
    transform: translateX(6px);
    box-shadow: none;
  }

  .accent-blue { border-left-color: var(--blue); }
  .accent-orange { border-left-color: var(--orange); }
  .accent-green { border-left-color: var(--green); }

  .card-num {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    opacity: 0.35;
  }

  .accent-blue .card-num { color: var(--blue); }
  .accent-orange .card-num { color: var(--orange); }
  .accent-green .card-num { color: var(--green); }

  .card-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 0.6rem;
  }

  .accent-blue .card-title { color: var(--blue); }
  .accent-orange .card-title { color: var(--orange); }
  .accent-green .card-title { color: var(--green); }

  .card-text {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  /* --- BOUTON --- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: var(--ease);
    align-self: flex-start;
  }

  .btn-primary {
    background-color: var(--text-main);
    color: var(--white);
    border: 2px solid var(--text-main);
    box-shadow: var(--shadow-sm);
  }

  .btn-primary:hover {
    background-color: var(--white);
    color: var(--text-main);
    border-color: var(--text-main);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .arrow-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: var(--ease);
  }

  .btn-primary:hover .arrow-icon {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .btn {
      width: 100%;
    }
    .card-title {
      font-size: 1.5rem;
    }
  }
</style>