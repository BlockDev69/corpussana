<style>
  :root {
    /* Palette cohérente avec le reste du site */
    --color-primary: #022c43;
    --color-primary-light: #053f5e;
    --color-accent: #eb690b;
    --color-accent-hover: #d55a08;
    --color-text: #0f172a;
    --color-text-muted: #475569;
    --color-bg-light: #f1f5f9;
    --color-border: #022c43;
    --color-border-light: #cbd5e1;
    
    /* Strict zero radius */
    --radius-sm: 0px;
    --radius-md: 0px;
    --radius-full: 0px;
    
    /* Hard, offset shadows for strict Square UI */
    --shadow-sm: 3px 3px 0px var(--color-primary);
    --shadow-md: 5px 5px 0px var(--color-primary);
    --shadow-lg: 8px 8px 0px var(--color-primary);
    
    --transition-smooth: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --nav-height: 88px;
  }

  ul { list-style: none; padding: 0; margin: 0; }
  a { text-decoration: none; color: inherit; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
  }

  /* --- TOP BAR --- */
  .top-bar {
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.6rem 0;
    border-bottom: 2px solid var(--color-accent);
  }
  .top-bar .container { min-height: 28px; }

  .social-links { display: flex; gap: 1.25rem; }
  .social-links a {
    color: rgba(255, 255, 255, 0.7);
    display: inline-flex;
    transition: var(--transition-smooth);
  }
  .social-links a:hover {
    color: var(--color-accent);
    transform: translate(-2px, -2px);
  }

  .top-bar-right { display: flex; align-items: center; gap: 1.5rem; }
  .top-separator {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.3);
    display: block;
  }

  .top-link {
    color: rgba(255, 255, 255, 0.85);
    position: relative;
    transition: var(--transition-smooth);
  }
  .top-link:hover { color: #ffffff; }
  .top-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }
  .top-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .lang-switch {
    display: flex;
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.3);
    padding: 0;
  }

  .lang-link {
    padding: 0.25rem 0.75rem;
    font-weight: 700;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    transition: var(--transition-smooth);
  }
  .lang-link:hover { color: #fff; }
  .lang-link.active {
    background-color: #ffffff;
    color: var(--color-primary);
  }

  /* --- MAIN NAV --- */
  .main-nav {
    background: #ffffff;
    border-bottom: 2px solid var(--color-primary);
  }
  .main-nav .container { height: var(--nav-height); }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    border: 2px solid var(--color-primary);
    padding: 0.4rem 0.8rem;
    background: #ffffff;
    transition: var(--transition-smooth);
  }
  .logo-text:hover {
    background: var(--color-primary);
    color: #ffffff;
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px var(--color-accent);
  }
  .logo-text strong {
    font-weight: 800;
    color: var(--color-accent);
  }
  .logo-text:hover strong { color: #ffffff; }

  .nav-wrapper {
    display: flex;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
    gap: 2.5rem;
  }

  .nav-list { display: flex; gap: 0.5rem; }

  .nav-item { position: relative; }
  .nav-item > a {
    display: flex;
    align-items: center;
    padding: 2rem 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 1.05rem;
    transition: var(--transition-smooth);
    border-bottom: 3px solid transparent;
  }
  .nav-item > a:hover { 
    color: var(--color-accent); 
    border-bottom-color: var(--color-accent);
  }

  .has-dropdown > a::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    margin-left: 0.5rem;
    margin-bottom: 2px;
    transition: transform 0.2s ease;
  }
  .has-dropdown:hover > a::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  /* --- DROPDOWN --- */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.98);
    min-width: 250px;
    background: #ffffff;
    border-radius: 0;
    border: 2px solid var(--color-primary);
    box-shadow: 6px 6px 0px var(--color-primary);
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 50;
  }

  .dropdown::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 14px;
    height: 14px;
    background: #ffffff;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
  }

  .dropdown.is-active,
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .dropdown li a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    border-radius: 0;
    border: 2px solid transparent;
    transition: var(--transition-smooth);
  }
  .dropdown li a:hover,
  .dropdown li a:focus {
    background: var(--color-bg-light);
    color: var(--color-accent);
    border-color: var(--color-accent);
    padding-left: 1.25rem;
  }

  /* --- CTA BUTTON --- */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.8rem;
    background-color: var(--color-accent);
    color: #ffffff;
    font-weight: 700;
    letter-spacing: 0.03em;
    font-size: 0.85rem;
    border: 2px solid var(--color-primary);
    border-radius: 0;
    box-shadow: 4px 4px 0px var(--color-primary);
    transition: var(--transition-smooth);
  }
  .cta-btn:hover {
    background-color: #ffffff;
    color: var(--color-accent);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--color-primary);
  }
  .cta-btn:active { 
    transform: translate(2px, 2px); 
    box-shadow: 2px 2px 0px var(--color-primary);
  }

  /* --- MOBILE MENU --- */
  .mobile-checkbox, .mobile-toggle-btn { display: none; }

  @media (max-width: 1024px) {
    :root { --nav-height: 72px; }
    .top-bar { display: none; }

    .mobile-toggle-btn {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 28px;
      height: 20px;
      cursor: pointer;
      z-index: 1001;
    }

    .hamburger-line {
      display: block;
      height: 3px;
      background-color: var(--color-primary);
      border-radius: 0;
      transition: var(--transition-smooth);
    }
    .hamburger-line:nth-child(1) { width: 100%; }
    .hamburger-line:nth-child(2) { width: 70%; align-self: flex-end; }
    .hamburger-line:nth-child(3) { width: 100%; }

    .nav-wrapper {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: #ffffff;
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem 2rem 2rem 2rem;
      gap: 0;
      border: 2px solid var(--color-primary);
      border-top: none;
      box-shadow: 8px 8px 0px var(--color-primary);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    }

    .mobile-checkbox:checked ~ .nav-wrapper {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-checkbox:checked ~ .mobile-toggle-btn .hamburger-line:nth-child(1) {
      transform: translateY(8.5px) rotate(45deg);
    }
    .mobile-checkbox:checked ~ .mobile-toggle-btn .hamburger-line:nth-child(2) {
      opacity: 0;
      transform: translateX(10px);
    }
    .mobile-checkbox:checked ~ .mobile-toggle-btn .hamburger-line:nth-child(3) {
      transform: translateY(-8.5px) rotate(-45deg);
      width: 100%;
    }

    .nav-list { 
      flex-direction: column; 
      gap: 0; 
      border-top: 2px solid var(--color-border-light);
      margin-top: 1rem;
    }

    .nav-item { width: 100%; border-bottom: 2px solid var(--color-border-light); }
    .nav-item:last-child { border-bottom: none; }
    
    .nav-item > a {
      padding: 1.25rem 0.75rem;
      font-size: 1.1rem;
      border-bottom: none;
      justify-content: space-between;
    }
    .nav-item > a:hover {
      color: var(--color-accent);
      background: var(--color-bg-light);
      padding-left: 1rem;
      padding-right: 1rem;
      margin: 0 -1rem;
    }

    .has-dropdown > a::after {
      transform: rotate(45deg) scale(1.2);
      margin-bottom: 0;
    }
    .has-dropdown:hover > a::after {
      transform: rotate(-135deg) scale(1.2);
    }

    .dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 2px solid var(--color-border-light);
      border-top: none;
      background: var(--color-bg-light);
      padding: 0.5rem;
      margin-bottom: 1rem;
      border-radius: 0;
      display: none;
      pointer-events: auto;
    }
    .dropdown::before { display: none; }

    .nav-item:hover .dropdown,
    .nav-item:focus-within .dropdown {
      display: block;
    }

    .dropdown li a {
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border: 2px solid transparent;
    }
    .dropdown li a:hover {
      background: #ffffff;
      color: var(--color-accent);
      border-color: var(--color-accent);
      padding-left: 1.25rem;
    }

    .nav-actions { margin-top: 1.5rem; }
    .nav-actions .cta-btn { width: 100%; padding: 1rem; }
  }
</style>