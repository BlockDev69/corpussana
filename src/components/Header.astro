<style>
  :root {
    --color-primary: #022c43;
    --color-primary-light: #053f5e;
    --color-accent: #ff5a1f;
    --color-accent-hover: #e0440b;
    --color-text: #0f172a;
    --color-text-muted: #475569;
    --color-bg-light: #f8fafc;
    --color-border: #e2e8f0;
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-full: 9999px;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.04);
    --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.05);
    --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    --nav-height: 88px;
  }

  ul { list-style: none; padding: 0; margin: 0; }
  a { text-decoration: none; color: inherit; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
  }

  .top-bar {
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .top-bar .container { min-height: 28px; }

  .social-links { display: flex; gap: 1.25rem; }
  .social-links a {
    color: rgba(255, 255, 255, 0.7);
    display: inline-flex;
    transition: var(--transition-smooth);
  }
  .social-links a:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .top-bar-right { display: flex; align-items: center; gap: 1.5rem; }

  .top-link {
    color: rgba(255, 255, 255, 0.85);
    position: relative;
    transition: var(--transition-smooth);
  }
  .top-link:hover { color: #ffffff; }
  .top-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: rgba(255,255,255,0.4);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }
  .top-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .lang-switch {
    display: flex;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px;
    border-radius: var(--radius-full);
  }

  .lang-link {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    transition: var(--transition-smooth);
  }
  .lang-link:hover { color: #fff; }
  .lang-link.active {
    background-color: #ffffff;
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .main-nav {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: var(--shadow-sm);
  }
  .main-nav .container { height: var(--nav-height); }

  .logo-text {
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }
  .logo-text strong {
    font-weight: 800;
    color: var(--color-accent);
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
    gap: 2.5rem;
  }

  .nav-list { display: flex; gap: 2rem; }

  .nav-item { position: relative; }
  .nav-item > a {
    display: flex;
    align-items: center;
    padding: 2rem 0;
    color: var(--color-primary);
    font-weight: 500;
    font-size: 1.3rem;
    transition: var(--transition-smooth);
  }
  .nav-item > a:hover { color: var(--color-accent); }

  .has-dropdown > a::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    margin-left: 0.5rem;
    transition: transform 0.2s ease;
  }
  .has-dropdown:hover > a::after {
    transform: rotate(-135deg) translateY(-1px);
  }

  .dropdown {
    position: absolute;
    top: 100%; /* Aligné pile sous le parent */
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.98);
    min-width: 250px;
    background: #ffffff;
    border-radius: 2px; /* Un angle très léger pour ne pas faire "brut", ou 0px pour un carré parfait */
    border: 1px solid #e2e8f0; /* Bordure fine moderne style Tailwind */
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    
    /* Transition fluide */
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 50;
  }

    /* --- La Flèche Stylisée --- */
  .dropdown::before {
    content: '';
    position: absolute;
    top: -6px; /* Moitié de la hauteur de la flèche */
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: #ffffff;
    
    /* On applique la même bordure haute et gauche pour correspondre au dropdown */
    border-top: 1px solid #e2e8f0;
    border-left: 1px solid #e2e8f0;
  }

  .dropdown.is-active,
    *:hover > .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(10px) scale(1);
  }
  .dropdown li a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: var(--transition-smooth);
  }
  .dropdown li a:hover,
  .dropdown li a:focus {
    background: var(--color-bg-light);
    color: var(--color-accent);
    padding-left: 1.25rem;
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
    pointer-events: auto;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.8rem;
    background-color: var(--color-accent);
    color: #ffffff;
    font-weight: 700;
    letter-spacing: 0.03em;
    font-size: 0.85rem;
    box-shadow: 0 4px 14px rgba(255, 90, 31, 0.25);
    transition: var(--transition-smooth);
  }
  .cta-btn:hover {
    background-color: var(--white);
    color: var(--color-accent);
    border-color: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 90, 31, 0.35);
  }
  .cta-btn:active { transform: translateY(0); }

  .mobile-checkbox, .mobile-toggle-btn { display: none; }

  @media (max-width: 1024px) {
    :root { --nav-height: 72px; }
    .top-bar { display: none; }

    .mobile-toggle-btn {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 26px;
      height: 18px;
      cursor: pointer;
      z-index: 1001;
    }

    .hamburger-line {
      display: block;
      height: 2px;
      background-color: var(--color-primary);
      border-radius: var(--radius-full);
      transition: var(--transition-smooth);
    }
    .hamburger-line:nth-child(1) { width: 100%; }
    .hamburger-line:nth-child(2) { width: 75%; align-self: flex-end; }
    .hamburger-line:nth-child(3) { width: 100%; }

    .nav-wrapper {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: #ffffff;
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem 2rem 2.5rem 2rem;
      gap: 2rem;
      box-shadow: var(--shadow-lg);
      border-top: 1px solid var(--color-border);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    }

    .mobile-checkbox:checked ~ .nav-wrapper {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-checkbox:checked ~ .mobile-toggle-btn .hamburger-line:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .mobile-checkbox:checked ~ .mobile-toggle-btn .hamburger-line:nth-child(2) {
      opacity: 0;
      transform: translateX(10px);
    }
    .mobile-checkbox:checked ~ .mobile-toggle-btn .hamburger-line:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
      width: 100%;
    }

    .nav-list { flex-direction: column; gap: 0.5rem; }

    .nav-item { width: 100%; }
    .nav-item > a {
      padding: 1rem 0;
      font-size: 1.05rem;
      border-bottom: 1px solid rgba(15, 23, 42, 0.04);
      justify-content: space-between;
    }

    /* .has-dropdown > a::after { transform: rotate(45deg) scale(1.2); }
    .has-dropdown:hover > a::after { transform: rotate(45deg) scale(1.2); }

    .dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      background: var(--color-bg-light);
      padding: 0.5rem;
      margin-top: 0.5rem;
      border-radius: var(--radius-md);
      display: block;
      pointer-events: auto;
    }
    .dropdown li a:hover { padding-left: 1rem; } */

    .nav-actions { margin-top: 0.5rem; }
    .nav-actions .cta-btn { width: 100%; padding: 1rem; }
  }
</style>