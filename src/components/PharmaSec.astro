---
// HerbalSec.astro
// Section "Pharmacopée traditionnelle" — Style Square UI / Neo-Brutalist

const steps = [
  {
    num: "01",
    color: "green",
    title: "Savoirs ancestraux",
    text: "Nous valorisons les connaissances des tradipraticiens sur les plantes médicinales locales et leurs usages éprouvés.",
    image:
      "https://images.unsplash.com/photo-1471864190281-a93a3070b6de?auto=format&fit=crop&w=600&q=80",
  },
  {
    num: "02",
    color: "blue",
    title: "Recherche & analyse",
    text: "Les principes actifs des herbes sont étudiés et validés scientifiquement pour garantir efficacité et sécurité.",
    image:
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
  },
  {
    num: "03",
    color: "orange",
    title: "Production de remèdes",
    text: "Des médicaments accessibles et standardisés sont élaborés à partir de ces ressources naturelles.",
    image:
      "https://images.unsplash.com/photo-1587854692152-cbe660dbde88?auto=format&fit=crop&w=600&q=80",
  },
  {
    num: "04",
    color: "green",
    title: "Accès aux communautés",
    text: "Nous distribuons ces solutions de santé durables aux populations qui en ont le plus besoin.",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80",
  },
];
---

<section class="herbal">
  <div class="container">
    <!-- En-tête -->
    <header class="section-header">
      <h2 class="section-title">
        Des plantes médicinales aux médicaments de demain
      </h2>
      <p class="section-subtitle">
        Nous transformons les savoirs traditionnels sur les herbes médicinales
        en solutions de santé fiables, en alliant patrimoine local et rigueur
        scientifique.
      </p>
    </header>

    <!-- Grille de cartes carrées -->
    <div class="herbal-grid">
      {
        steps.map((step, i) => (
          <article class={`herbal-card accent-${step.color}`}>
            <div class="card-media">
              <img src={step.image} alt={step.title} loading="lazy" />
              <span class="card-num" aria-hidden="true">{step.num}</span>
            </div>
            <div class="card-body">
              <h3 class="card-title">{step.title}</h3>
              <p class="card-text">{step.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="herbal-footer">
      <a class="btn-products" href="/fr/produits">
        En savoir plus
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* --- DESIGN TOKENS (Square UI) --- */
  .herbal {
    --color-primary: #022c43;
    --color-text: #0f172a;
    --blue: #009cb4;
    --orange: #eb690b;
    --green: #48a23f;
    --white: #ffffff;
    
    /* Strict zero radius */
    --radius: 0px;
    
    /* Hard, offset shadows for strict Square UI */
    --shadow-hard: 5px 5px 0px var(--color-primary);
    --shadow-hard-lg: 8px 8px 0px var(--color-primary);
    
    --ease: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: var(--green);
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    color: var(--white);
    overflow: hidden;
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- EN-TÊTE --- */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--white);
  }

  .section-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  /* --- GRILLE CARRÉE --- */
  .herbal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* --- CARTE CARRÉE --- */
  .herbal-card {
    display: flex;
    flex-direction: column;
    background-color: var(--white);
    border: 3px solid var(--color-primary);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard);
    overflow: hidden;
    transition: var(--ease);
    
    /* Robust stagger logic using CSS variables to prevent transform conflicts */
    --stagger: 0px;
    transform: translateY(var(--stagger));
  }

  .herbal-card:nth-child(even) {
    --stagger: 2.5rem;
  }

  .herbal-card:hover {
    transform: translateY(calc(var(--stagger) - 4px));
    box-shadow: var(--shadow-hard-lg);
  }

  .accent-blue:hover { border-color: var(--blue); }
  .accent-orange:hover { border-color: var(--orange); }
  .accent-green:hover { border-color: var(--green); }

  .card-media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #e2e8f0;
    border-bottom: 3px solid var(--color-primary);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .herbal-card:hover .card-media img {
    transform: scale(1.05);
  }

  .card-num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--white);
    background-color: var(--color-primary);
    border: 2px solid var(--white);
    border-radius: var(--radius);
  }

  .accent-blue .card-num { background-color: var(--blue); }
  .accent-orange .card-num { background-color: var(--orange); }
  .accent-green .card-num { background-color: var(--green); }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    flex: 1;
    border-top: 4px solid var(--color-primary);
  }

  .accent-blue .card-body { border-top-color: var(--blue); }
  .accent-orange .card-body { border-top-color: var(--orange); }
  .accent-green .card-body { border-top-color: var(--green); }

  .card-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
    color: var(--color-text);
  }

  .card-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
    opacity: 0.85;
  }

  /* --- BOUTON --- */
  .herbal-footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .btn-products {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    background-color: var(--white);
    color: var(--color-primary);
    border: 3px solid var(--color-primary);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard);
    transition: var(--ease);
    letter-spacing: 0.02em;
  }

  .btn-products svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.2s ease;
  }

  .btn-products:hover {
    background-color: var(--color-primary);
    color: var(--white);
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0px var(--white);
  }

  .btn-products:hover svg {
    transform: translateX(4px);
  }

  .btn-products:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--color-primary);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 900px) {
    .herbal-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    
    .herbal-card:nth-child(even) {
      --stagger: 1.5rem;
    }
  }

  @media (max-width: 560px) {
    .herbal {
      padding: 3rem 1.25rem;
    }

    .herbal-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* Reset stagger on mobile for clean vertical stacking */
    .herbal-card,
    .herbal-card:nth-child(even) {
      --stagger: 0px;
    }

    .herbal-card:hover {
      transform: translateY(-4px);
    }

    .card-title {
      font-size: 1.05rem;
    }

    .card-text {
      font-size: 0.9rem;
    }

    .btn-products {
      width: 100%;
    }
    
    .btn-products:active {
      transform: translate(1px, 1px);
      box-shadow: 1px 1px 0px var(--color-primary);
    }
  }
</style>