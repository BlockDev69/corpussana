---
// HerbalSec.astro
// Section "Pharmacopée traditionnelle" — design carré inspiré d'EngagementSec

const steps = [
  {
    num: "01",
    color: "green",
    title: "Savoirs ancestraux",
    text: "Nous valorisons les connaissances des tradipraticiens sur les plantes médicinales locales et leurs usages éprouvés.",
    image:
      "https://images.unsplash.com/photo-1471864190281-a93a3070b6de?auto=format&fit=crop&w=600&q=80",
  },
  {
    num: "02",
    color: "blue",
    title: "Recherche & analyse",
    text: "Les principes actifs des herbes sont étudiés et validés scientifiquement pour garantir efficacité et sécurité.",
    image:
      "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80",
  },
  {
    num: "03",
    color: "orange",
    title: "Production de remèdes",
    text: "Des médicaments accessibles et standardisés sont élaborés à partir de ces ressources naturelles.",
    image:
      "https://images.unsplash.com/photo-1587854692152-cbe660dbde88?auto=format&fit=crop&w=600&q=80",
  },
  {
    num: "04",
    color: "green",
    title: "Accès aux communautés",
    text: "Nous distribuons ces solutions de santé durables aux populations qui en ont le plus besoin.",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80",
  },
];
---

<section class="herbal">
  <div class="container">
    <!-- En-tête -->
    <header class="section-header">
      <h2 class="section-title">
        Des plantes médicinales aux médicaments de demain
      </h2>
      <p class="section-subtitle">
        Nous transformons les savoirs traditionnels sur les herbes médicinales
        en solutions de santé fiables, en alliant patrimoine local et rigueur
        scientifique.
      </p>
    </header>

    <!-- Grille de cartes carrées -->
    <div class="herbal-grid">
    {
        steps.map((step, i) => (
        <article class={`herbal-card accent-${step.color}`} style={`--i:${i}`}>
            <div class="card-media">
            <img src={step.image} alt={step.title} loading="lazy" />
            <span class="card-num" aria-hidden="true">{step.num}</span>
            </div>
            <div class="card-body">
            <h3 class="card-title">{step.title}</h3>
            <p class="card-text">{step.text}</p>
            </div>
        </article>
        ))
    }
    </div>
    <div class="herbal-footer">
    <a class="btn-products" href="/fr/produits">
        En savoir plus
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
    </a>
    </div>
  </div>
</section>

<style>
  /* --- DESIGN TOKENS --- */
  .herbal {
    --text-main: #1e293b;
    --text-muted: #64748b;
    --blue: #009cb4;
    --orange: #eb690b;
    --green: #48a23f;
    --bg-section: #f8fafc;
    --white: #ffffff;
    --shadow-sm: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.08);
    --radius-md: 12px;
    --ease: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: var(--green);
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    color: var(--text-main);
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- EN-TÊTE --- */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
    color: var(--white);
  }

  .section-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--white);
    margin: 0;
  }

  /* --- GRILLE CARRÉE --- */
  .herbal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .herbal-card:nth-child(even) {
    transform: translateY(2.5rem);
  }

  /* --- CARTE CARRÉE --- */
  .herbal-card {
    display: flex;
    flex-direction: column;
    background-color: var(--white);
    overflow: hidden;
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
    transition: var(--ease);
  }

  .herbal-card:hover {
    transform: translateY(calc(2.5rem - 8px));
  }

  .card-media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #e2e8f0;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .herbal-card:hover .card-media img {
    transform: scale(1.08);
  }

  .card-num {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 800;
    color: var(--white);
    backdrop-filter: blur(4px);
    background-color: rgba(15, 23, 42, 0.45);
  }

  .accent-blue .card-num { background-color: rgba(0, 156, 180, 0.85); }
  .accent-orange .card-num { background-color: rgba(235, 105, 11, 0.85); }
  .accent-green .card-num { background-color: rgba(72, 162, 63, 0.9); }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.4rem 1.6rem;
    border-top: 4px solid transparent;
  }

  .accent-blue .card-body { border-top-color: var(--blue); }
  .accent-orange .card-body { border-top-color: var(--orange); }
  .accent-green .card-body { border-top-color: var(--green); }

  .card-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
    color: var(--text-main);
  }

  .card-text {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-main);
    margin: 0;
  }

    /* --- BOUTON --- */
  .herbal-footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .btn-products {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    background-color: var(--green);
    color: var(--white);
    border: 2px solid var(--white);
    transition: var(--ease);
  }

  .btn-products svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: var(--ease);
  }

  .btn-products:hover {
    background-color: var(--white);
    color: var(--green);
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-products:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .btn-products {
      width: 100%;
    }
  }

  @media (max-width: 900px) {
    .herbal-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }
    .herbal-card:nth-child(even) {
        transform: translateY(1.5rem);
    }
    .herbal-card:nth-child(even):hover {
        transform: translateY(calc(1.5rem - 8px));
    }
  }
/* --- MOBILE --- */
  @media (max-width: 560px) {
    .herbal-grid {
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
    .herbal-card:nth-child(even),
    .herbal-card:nth-child(even):hover {
        transform: none;
    }
    .herbal-card:hover {
        transform: translateY(-6px);
    }
    .card-title { font-size: 1.05rem; }
    .card-text { font-size: 0.875rem; }
  }
</style>