---
import { getCollection } from "astro:content";
import { turso } from "../turso";

const result = await turso.execute({
  sql: `SELECT slug, title, summary, date, image, color
        FROM articles
        ORDER BY date DESC
        LIMIT 4`,
  args: []
  });

const articles = result.rows;

// Fallbacks for visual consistency if image/color are missing in JSON
const fallbackColors = ["blue", "orange", "green", "blue"];
const defaultImage = "https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=800&q=80";
---

<section class="actu">
  <div class="container">
    <!-- En-tête -->
    <header class="section-header">
      <div class="header-text">
        <h2 class="section-title">NOS DERNIERES PUBLICATIONS</h2>
        <p class="section-subtitle">
          Suivez nos actions sur le terrain, nos réflexions et les temps forts
          de notre engagement.
        </p>
      </div>

      <!-- Boutons de scroll (desktop) -->
      <div class="scroll-controls">
        <button class="scroll-btn" data-dir="prev" aria-label="Articles précédents">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>
        <button class="scroll-btn" data-dir="next" aria-label="Articles suivants">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </header>

    <!-- Piste de cartes scrollable -->
    <div class="cards-track" id="actuTrack">
      {
        articles.map((article, index) => {
          const articleColor = article.color || fallbackColors[index % fallbackColors.length];
          const articleImage = article.image || defaultImage;
          const formattedDate = new Date(article.date).toLocaleDateString('fr-FR', {
            year: 'numeric', month: 'long', day: 'numeric'
          })

          return (
            <article class={`actu-card accent-${articleColor}`}>
              <a href={`/articles/${article.slug}`} class="card-link">
                <div class="card-media">
                  <img src={articleImage} alt={article.title} loading="lazy" />
                </div>
                <div class="card-body">
                  <span class="card-date">{formattedDate}</span>
                  <h3 class="card-title">{article.title}</h3>
                  <p class="card-excerpt">{article.summary}</p>
                  <span class="card-cta">
                    Lire la suite
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    <div class="actu-footer">
      <a class="btn-all" href="/articles">
        Voir toutes les actualités
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("actuTrack");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".scroll-btn");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!track) return;
      const card = track.querySelector<HTMLElement>(".actu-card");
      const gap = 24; // Matches CSS gap
      const amount = card ? card.offsetWidth + gap : track.clientWidth * 0.8;
      const dir = btn.dataset.dir === "next" ? 1 : -1;
      track.scrollBy({ left: amount * dir, behavior: "smooth" });
    });
  });
</script>

<style>
  /* --- DESIGN TOKENS (Square UI) --- */
  .actu {
    --navy: #022c43;
    --navy-soft: #053f5e;
    --blue: #009cb4;
    --orange: #eb690b;
    --green: #48a23f;
    --white: #ffffff;
    --text-light: #e2e8f0;
    --text-muted: #94a3b8;
    
    --radius: 0px;
    --shadow-hard: 4px 4px 0px rgba(0, 0, 0, 0.4);
    --shadow-hard-lg: 7px 7px 0px rgba(0, 0, 0, 0.6);
    --ease: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: var(--navy);
    padding: clamp(4rem, 8vw, 7rem) 0;
    color: var(--white);
    overflow: hidden;
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* --- EN-TÊTE --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .header-text { max-width: 640px; }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--white);
  }

  .section-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-light);
    margin: 0;
    font-weight: 500;
  }

  /* --- BOUTONS DE SCROLL --- */
  .scroll-controls {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .scroll-btn {
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--white);
    background-color: var(--navy);
    color: var(--white);
    cursor: pointer;
    border-radius: var(--radius);
    box-shadow: 3px 3px 0px var(--white);
    transition: var(--ease);
  }

  .scroll-btn svg { width: 1.25rem; height: 1.25rem; }

  .scroll-btn:hover {
    background-color: var(--white);
    color: var(--navy);
    border-color: var(--white);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--navy);
  }

  .scroll-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--white);
  }

  /* --- PISTE DE CARTES --- */
  .cards-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(320px, 1fr);
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scrollbar-width: none;
  }

  .cards-track::-webkit-scrollbar { display: none; }

  /* --- CARTE --- */
  .actu-card {
    scroll-snap-align: start;
    background-color: var(--navy-soft);
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-bottom: 4px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard);
    transition: var(--ease);
  }

  .actu-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hard-lg);
  }

  .accent-blue:hover { border-color: var(--blue); border-bottom-color: var(--blue); }
  .accent-orange:hover { border-color: var(--orange); border-bottom-color: var(--orange); }
  .accent-green:hover { border-color: var(--green); border-bottom-color: var(--green); }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #1e293b;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .actu-card:hover .card-media img { transform: scale(1.03); }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.5rem 1.75rem;
    flex: 1;
  }

  .card-date {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: var(--white);
  }

  .card-excerpt {
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
    font-weight: 500;
    flex: 1;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--blue);
  }

  .accent-orange .card-cta { color: var(--orange); }
  .accent-green .card-cta { color: var(--green); }

  .card-cta svg { width: 1rem; height: 1rem; transition: var(--ease); }
  .actu-card:hover .card-cta svg { transform: translateX(4px); }

  /* --- FOOTER & BOUTON GLOBAL --- */
  .actu-footer {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .btn-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: var(--ease);
    background-color: var(--white);
    color: var(--navy);
    border: 2px solid var(--white);
    border-radius: var(--radius);
    box-shadow: 4px 4px 0px var(--navy);
    letter-spacing: 0.02em;
  }

  .btn-all svg { width: 1.25rem; height: 1.25rem; transition: var(--ease); }

  .btn-all:hover {
    background-color: var(--navy);
    color: var(--white);
    border-color: var(--white);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--white);
  }

  .btn-all:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--white);
  }

  /* --- MOBILE --- */
  @media (max-width: 768px) {
    .section-header { flex-direction: column; align-items: flex-start; }
    .scroll-controls { display: none; }

    .cards-track {
      grid-auto-columns: 85%;
      gap: 1rem;
      margin: 0 -1.5rem;
      padding: 0 1.5rem 1rem;
    }

    .card-title { font-size: 1.1rem; }
    .card-excerpt { font-size: 0.9rem; }
    .card-cta { font-size: 0.85rem; }
    .card-body { gap: 0.45rem; padding: 1.25rem 1.25rem 1.5rem; }
    
    .btn-all { width: 100%; }
    .btn-all:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0px var(--white); }
  }
</style>
