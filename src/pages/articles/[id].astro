---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// 1. Tell Astro which pages to generate at build time
export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { id: article.data.id },
    props: { article },
  }));
}

// 2. Access the specific article data
const { article } = Astro.props;
const formattedDate = new Date(article.data.date).toLocaleDateString('fr-FR', { 
  year: 'numeric', month: 'long', day: 'numeric' 
});
---

<BaseLayout title={article.data.title}>
  <article class="article-detail">
    <div class="container">
      <a href="/articles" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        Retour aux publications
      </a>

      <header class="article-header">
        <time class="article-date">{formattedDate}</time>
        <h1 class="article-title">{article.data.title}</h1>
        <div class="article-meta">
          <span class="author-badge">Rédigé par <strong>{article.data.author}</strong></span>
        </div>
      </header>

      <div class="article-content">
        <!-- 
          NOTE: Since you are using JSON, long text with line breaks can be messy. 
          For now, we display the summary prominently. 
          See the "Pro Tip" below for handling rich text.
        -->
        <p class="lead-text">{article.data.summary}</p>
        
        <div class="placeholder-content">
          <p>Le contenu détaillé de cet article sera bientôt disponible.</p>
          <p><em>(Pour ajouter du texte riche avec des paragraphes, des images et du gras, nous vous recommandons vivement de passer du JSON au Markdown. Voir l'astuce ci-dessous).</em></p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-detail {
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    background: var(--white, #ffffff);
    color: var(--text-main, #0f172a);
  }
  .container { max-width: 800px; margin: 0 auto; }

  .back-link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; font-weight: 700; color: var(--blue, #009cb4);
    text-decoration: none; margin-bottom: 3rem; transition: all 0.2s;
  }
  .back-link svg { width: 16px; height: 16px; }
  .back-link:hover { transform: translateX(-4px); }

  .article-header {
    margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 3px solid var(--navy, #022c43);
  }
  .article-date {
    font-size: 0.85rem; font-weight: 600; color: var(--text-muted, #475569);
    text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 1rem;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; line-height: 1.1;
    color: var(--navy, #022c43); margin: 0 0 1.5rem; letter-spacing: -0.02em;
  }
  .author-badge {
    display: inline-block; padding: 0.5rem 1rem; background: var(--bg-soft, #f1f5f9);
    border: 2px solid var(--navy, #022c43); font-size: 0.9rem; font-weight: 600;
  }

  .article-content { font-size: 1.125rem; line-height: 1.8; }
  .lead-text {
    font-size: 1.25rem; font-weight: 500; color: var(--navy, #022c43);
    border-left: 4px solid var(--orange, #eb690b); padding-left: 1.5rem; margin-bottom: 2.5rem;
  }
  .placeholder-content {
    padding: 2rem; background: var(--bg-soft, #f1f5f9); border: 2px dashed var(--border-light, #cbd5e1);
  }
  .placeholder-content p { margin: 0 0 1rem; }
  .placeholder-content p:last-child { margin: 0; font-size: 0.95rem; color: var(--text-muted, #475569); }
</style>
