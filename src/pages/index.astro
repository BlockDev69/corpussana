---
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import PartnerBar from "../components/PartnerBar.astro"
import EngagementSec from "../components/EngagementSec.astro"
import ActuSec from "../components/ActuSec.astro"
import PharmaSec from "../components/PharmaSec.astro"
import Footer from "../components/Footer.astro"
---

<BaseLayout title="Accueil - Corpus Sana">
  <Hero />
  <PartnerBar />
  <section class="wr-block b-welcome bg-offwhite pb-xxl paragraph--type--welcome">
    <div class="container">
      <div class="innerblock align-center">
        <p>
          CORPUS SANA ONGD est une Organisation non-gouvernementale basé en RD Congo, qui a vu le jour en Novembre 2018 à Kinshasa, dans le but de Promouvoir le bien-être universel et intégral de l'Homme au centre de toutes les préoccupations et activités en général, et celles liées à la santé en particulier.
        </p>
      </div>
    </div>
  </section>
  <EngagementSec />
  <ActuSec />
  <PharmaSec />
  <Footer />
</BaseLayout>

<style>
  /* Base & Variables */
  .bg-offwhite {
    background-color: #0b1b3a; /* Teinte white off chaleureuse */
    color: #ffffff;
  }

  /* Structure & Spacing (Paddings) */
  .wr-block {
    width: 100%;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .pt-xxl, .wr-block {
    padding-top: 5rem; /* Adjust the padding-top (xxl) value according to your needs */
  }

  .pb-xxl {
    padding-bottom: 5rem; /* Adjust the padding-bottom (xxl) value according to your needs */
  }

  .container {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  /* Alignement and Typography */
  .innerblock.align-center {
    text-align: center;
    max-width: 800px; /* Limit the width for better readability */
    margin: 0 auto;
  }

  .paragraph--type--welcome p {
    font-size: 1.50rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 400px) {
    .paragraph--type--welcome p {
      font-size: 1.25rem;
    }
  }
</style>
