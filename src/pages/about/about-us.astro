---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets"

import img1 from "../../assets/img/img-1.jpg"
import shape1 from "../../assets/img/shape-1.avif"

import partner1 from "../../assets/partners/partner-1.png"
import partner2 from "../../assets/partners/partner-2.png"
import partner3 from "../../assets/partners/partner-3.png"
import partner4 from "../../assets/partners/partner-4.png"

const values = [
  {
    color: "blue",
    icon: "heart",
    title: "Bien-être intégral",
    text: "Placer le bien-être universel et intégral de l'Homme au centre de toutes nos préoccupations et activités.",
  },
  {
    color: "orange",
    icon: "flask",
    title: "Innovation & rigueur",
    text: "Allier savoirs traditionnels et rigueur scientifique pour des solutions de santé fiables et durables.",
  },
  {
    color: "green",
    icon: "people",
    title: "Engagement communautaire",
    text: "Agir au plus près des populations et bâtir des partenariats solides pour un impact réel sur le terrain.",
  },
];

const stats = [
  { value: "2018", label: "Année de création", icon: "calendar" },
  { value: "RDC", label: "Ancrage local", icon: "map" },
  { value: "100%", label: "Dédié à la santé", icon: "health" },
];

const timeline = [
  { year: "2018", title: "Création", text: "Fondation de Corpus Sana en RD Congo avec une vision claire : améliorer la santé des communautés." },
  { year: "2020", title: "Expansion", text: "Développement de partenariats stratégiques avec des organisations internationales." },
  { year: "2022", title: "Innovation", text: "Lancement des Journées Internationales Odontologia de Kinshasa." },
  { year: "2024", title: "Impact", text: "Renforcement de notre ancrage communautaire et extension de nos programmes de santé." },
];

const partners = [
  {
    name: "AGAPE",
    logo: partner1,
    description: "Une Association Italienne qui œuvre depuis plusieurs années en RD Congo dans le secteur du développement durable. AGAPE Onlus est le premier partenaire le plus actif de notre Association.",
    url: "www.agepeets.org"
  },
  {
    name: "Moninga",
    logo: partner2,
    description: "Une association Italienne qui apporte son expertise dans le developpement durable en RD Congo",
    url: "www.moninga.it"
  },
  {
    name: "Shalina Healthcare",
    logo: partner3,
    description: "Une firme de taille qui sponsorise les Journées Internationales Odontologia de Kinshasa, organisées par Corpus sana ongd",
    url: "www.shalina.com"
  },
  {
    name: "ASFINT (Architettura SenzaFrontiere ONLUS)",
    logo: partner4,
    description: "Une organisation Italienne qui apporte son expertise dans plusieurs domaines, plus particulièrement dans le domaine de la construction",
    url: "www.asfint.org"
  },
]
---

<BaseLayout title="À propos - Corpus Sana">
  <section class="about">
    <!-- HERO -->
    <header class="about-hero" style={`background: var(--navy) url('${shape1}') center/cover no-repeat;`}>
      <div class="hero-pattern"></div>
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">Qui sommes-nous<span class="hero-accent">.</span></h1>
          <p class="hero-subtitle">
            Depuis 2018, nous œuvrons pour un bien-être universel et intégral,
            en alliant savoirs traditionnels et rigueur scientifique au service des communautés.
          </p>
          <div class="hero-actions">
            <a href="#histoire" class="btn btn-primary">Notre histoire</a>
            <a href="/contact" class="btn btn-outline">Nous contacter</a>
          </div>
        </div>
        <div class="hero-scroll" aria-hidden="true">
          <span>Découvrir</span>
          <div class="scroll-line"></div>
        </div>
      </div>
    </header>

    <!-- STATS -->
    <div class="container">
      <ul class="stats">
        {
          stats.map((s) => (
            <li class="stat">
              <div class="stat-icon" data-icon={s.icon}>
                {s.icon === "calendar" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="0"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                )}
                {s.icon === "map" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                )}
                {s.icon === "health" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                )}
              </div>
              <div class="stat-body">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- NOTRE HISTOIRE -->
    <div class="container" id="histoire">
      <div class="story">
        <div class="story-media">
          <div class="story-image">
            <Image src={img1} alt="Nos équipes sur le terrain" widths={[768, 1280, 1920]} sizes="100vw" format="webp" quality={75} loading="lazy" />
          </div>
          <div class="story-badge">
            <span class="badge-year">Depuis</span>
            <span class="badge-number">2018</span>
            <span class="badge-label">à vos côtés</span>
          </div>
        </div>
        <div class="story-content">
          <h2 class="section-title">D'une vision locale à un impact durable</h2>
          <p class="lead">
            Depuis 2018, Corpus Sana œuvre pour promouvoir le bien-être
            universel et intégral de l'Homme, avec une attention particulière
            portée à la santé.
          </p>
          <p>
            Nous valorisons les savoirs traditionnels, notamment autour des plantes médicinales,
            et les transformons en solutions de santé accessibles au plus grand nombre.
            Notre approche associe l'expertise scientifique, l'innovation et un
            profond ancrage communautaire pour répondre aux défis de santé les plus concrets sur le terrain.
          </p>
          <div class="story-features">
            <div class="feature">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div>
                <h4>Savoirs traditionnels</h4>
                <p>Valorisation des plantes médicinales</p>
              </div>
            </div>
            <div class="feature">
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div>
                <h4>Rigueur scientifique</h4>
                <p>Solutions fiables et durables</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TIMELINE -->
    <div class="container">
      <div class="timeline-section">
        <div class="section-header">
          <h2 class="section-title">Les étapes clés de notre évolution</h2>
        </div>
        <div class="timeline">
          {
            timeline.map((item, i) => (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <span class="timeline-year">{item.year}</span>
                </div>
                <div class="timeline-content">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- MISSION / VISION -->
    <div class="container">
      <div class="mv-grid">
        <article class="mv-card accent-blue">
          <div class="mv-number">01</div>
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h2>Notre mission</h2>
          <p>
            Nous luttons pour l'amélioration de l'état de Santé des populations, dans toutes ses formes possibles.
            Nous croyons que chaque humain est doté d'un potentiel qui puisse lui permettre de donner sa singularité comme un atout au développement physique, psychique et social de la communauté.
          </p>
        </article>
        <article class="mv-card accent-orange">
          <div class="mv-number">02</div>
          <div class="mv-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h2>Notre vision</h2>
          <p>
            CORPUS SANA s'intéresse au bien être complet de l'Homme (Bien-être Physique, mental, et social)
            afin de contribuer à l'amélioration des conditions de vie de communautés.
          </p>
        </article>
      </div>
    </div>

    <!-- VALEURS -->
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Ce qui guide notre action</h2>
        <p class="section-subtitle">
          Trois principes fondamentaux orientent chacune de nos décisions et actions au quotidien.
        </p>
      </div>
      <ul class="values">
        {
          values.map((v) => (
            <li class={`value-card accent-${v.color}`}>
              <div class="value-icon">
                {v.icon === "heart" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                )}
                {v.icon === "flask" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 2v6L4 18a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-10V2"/><line x1="8" y1="2" x2="16" y2="2"/><line x1="6" y1="14" x2="18" y2="14"/></svg>
                )}
                {v.icon === "people" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                )}
              </div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
              <div class="value-line"></div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PARTENAIRES (Dark Section) -->
  <section class="partners-section" aria-labelledby="partners-title">
    <div class="container">
      <div class="section-header">
        <h2 id="partners-title" class="section-title">Nos partenaires de confiance</h2>
        <p class="section-subtitle">
          Nous collaborons avec des acteurs engagés pour offrir des solutions innovantes et performantes.
        </p>
      </div>

      <div class="partners-grid">
        {partners.map((partner) => (
          <a
            href={`https://${partner.url}`}
            class="partner-card"
            target="_blank"
            rel="noopener noreferrer"
            title={`En savoir plus sur ${partner.name}`}
          >
            <div class="partner-logo-wrapper">
              <Image
                src={partner.logo}
                alt={`Logo ${partner.name}`}
                class="partner-logo"
                loading="lazy"
                width="150"
                height="60"
              />
            </div>
            <div class="partner-info">
              <h3 class="partner-name">{partner.name}</h3>
              <p class="partner-description">{partner.description}</p>
            </div>
            <span class="partner-link">
              Découvrir
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA (Dark Section) -->
  <section>
    <div class="container">
      <div class="cta">
        <div class="cta-inner">
          <h2 class="section-title">Envie de soutenir notre action ?</h2>
          <p class="section-subtitle" style="max-width: 100%;">Rejoignez-nous pour bâtir un avenir plus sain pour tous. Chaque geste compte.</p>
          <div class="cta-actions">
            <a href="/faire-un-don" class="btn btn-accent">
              Faire un don
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
            <a href="/contact" class="btn btn-ghost">Nous contacter</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- GLOBAL VARIABLES (Single Source of Truth) --- */
  :root {
    --navy: #022c43;
    --navy-dark: #011a2a;
    --blue: #009cb4;
    --blue-light: #e6f6f9;
    --orange: #eb690b;
    --orange-light: #fdf0e6;
    --green: #48a23f;
    --green-light: #eaf5e8;
    --text-main: #0f172a;
    --text-muted: #475569;
    --white: #ffffff;
    --bg-soft: #f1f5f9;
    --border: #022c43;
    --border-light: #cbd5e1;
    
    --shadow-sm: 4px 4px 0px var(--navy);
    --shadow-md: 6px 6px 0px var(--navy);
    --shadow-lg: 8px 8px 0px var(--navy);
    
    --ease: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --radius: 0px;
  }

  .about {
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--text-main);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background: var(--white);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* --- TYPOGRAPHY --- */
  .section-title {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy);
    margin: 0 0 1rem;
  }

  .section-subtitle {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
  }
  .section-header .section-eyebrow { justify-content: center; }
  .section-header .section-eyebrow::before { display: none; }

  /* --- EXPLICIT DARK SECTION OVERRIDES (No ".light" classes needed) --- */
  .partners-section,
  .cta {
    color: var(--white);
  }

  .partners-section .section-eyebrow,
  .cta .section-eyebrow {
    color: var(--white);
  }
  .partners-section .section-eyebrow::before,
  .cta .section-eyebrow::before {
    background: var(--blue);
  }

  .partners-section .section-title,
  .cta .section-title {
    color: var(--white);
  }

  .partners-section .section-subtitle,
  .cta .section-subtitle {
    color: #e2e8f0; /* Hardcoded high-contrast light gray */
    font-weight: 500;
  }

  /* --- HERO --- */
  .about-hero {
    position: relative;
    background-size: cover;
    background-position: center;
    color: var(--white);
    padding: clamp(7rem, 14vw, 10rem) 0 clamp(5rem, 10vw, 7rem);
    overflow: hidden;
    border-bottom: 4px solid var(--navy);
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    background-color: rgba(2, 44, 67, 0.92);
    pointer-events: none;
  }
  .about-hero .container { position: relative; z-index: 2; }
  .hero-content { max-width: 820px; }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
  }
  .hero-accent { color: var(--orange); }
  
  .hero-subtitle {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: #e2e8f0; /* Hardcoded high-contrast */
    margin: 0 0 2.5rem;
    max-width: 640px;
    font-weight: 500;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #e2e8f0; /* Hardcoded high-contrast */
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .scroll-line {
    width: 2px;
    height: 50px;
    background: var(--white);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 0.7; }
    50% { transform: scaleY(0.5); opacity: 1; }
  }

  /* --- BUTTONS --- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 1.85rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--ease);
    border: 2px solid var(--navy);
    border-radius: var(--radius);
    text-decoration: none;
    letter-spacing: 0.01em;
    box-shadow: 4px 4px 0px var(--navy);
  }
  .btn svg { width: 16px; height: 16px; transition: transform 0.2s ease; }
  .btn:hover svg { transform: translateX(4px); }
  .btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--navy);
  }
  .btn-primary {
    background: var(--white);
    color: var(--navy);
    border-color: var(--navy);
  }
  .btn-primary:hover {
    background: var(--orange);
    border-color: var(--navy);
    color: var(--white);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--navy);
  }
  .btn-outline {
    background: transparent;
    color: var(--white);
    border-color: var(--white);
    box-shadow: 4px 4px 0px rgba(255,255,255,0.3);
  }
  .btn-outline:hover {
    background: var(--white);
    color: var(--navy);
    border-color: var(--white);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px rgba(255,255,255,0.5);
  }
  .btn-accent {
    background: var(--orange);
    color: var(--white);
    border-color: var(--navy);
  }
  .btn-accent:hover {
    background: #d55a08;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--navy);
  }
  .btn-ghost {
    background: transparent;
    color: var(--white);
    border-color: var(--white);
    box-shadow: 4px 4px 0px rgba(255,255,255,0.2);
  }
  .btn-ghost:hover {
    background: var(--white);
    color: var(--navy);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px rgba(255,255,255,0.4);
  }

  /* --- STATS --- */
  .stats {
    list-style: none;
    margin: -4rem auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    background: var(--white);
    border: 2px solid var(--navy);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    position: relative;
    z-index: 3;
    overflow: hidden;
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 2rem 1.75rem;
    position: relative;
    transition: var(--ease);
    border-right: 2px solid var(--navy);
  }
  .stat:last-child { border-right: none; }
  .stat:hover { background: var(--blue-light); }
  
  .stat-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: var(--white);
    border: 2px solid var(--blue);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .stat-icon svg { width: 24px; height: 24px; }
  .stat-body { display: flex; flex-direction: column; }
  .stat-value {
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--navy);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-label {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* --- HISTOIRE --- */
  .story {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  @media (min-width: 900px) {
    .story { grid-template-columns: 1.05fr 1fr; gap: 5rem; }
  }
  .story-media { position: relative; }
  
  .story-image {
    overflow: hidden;
    border-radius: var(--radius);
    border: 2px solid var(--navy);
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 3;
    background: var(--bg-soft);
  }
  .story-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .story-image:hover img { transform: scale(1.03); }

  .story-badge {
    position: absolute;
    bottom: -2rem;
    right: -1rem;
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-md);
    border: 2px solid var(--navy);
    border-left-width: 6px;
    border-left-color: var(--orange);
    display: flex;
    flex-direction: column;
